# BotFather-dan alınan token (məcburi)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Yalnız bu chat ID-lərə cavab versin (boş = hamıya açıq). Vergüllə ayır.
ALLOWED_CHAT_IDS=

# Yeni chat üçün başlanğıc izləmə siyahısı
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN

# Gündəlik xülasə: hansı chat-a və neçədə (HH:MM, UTC). Boş = söndürülüb.
DIGEST_CHAT_ID=
DIGEST_TIME=07:30

# Hər simvol üçün neçə xəbər göstərilsin
NEWS_PER_SYMBOL=4

# Bundan köhnə xəbərlər göstərilmir (gün). 0 = filtr yoxdur.
NEWS_MAX_AGE_DAYS=3

# İzləmə siyahılarının saxlandığı fayl
STATE_PATH=state.json
